# Порт HTTP-сервера
PORT=3000
# Строка подключения к PostgreSQL (обязательно)
DATABASE_URL=postgres://runvision:runvision@localhost:5432/runvision
# Разрешённые источники фронта (через запятую)
CORS_ORIGINS=http://localhost:5173,https://maxrusmos.github.io
# Сколько дней живёт сессия
SESSION_TTL_DAYS=30
# Доверять заголовку X-Forwarded-For (true за прокси хостинга: Render/Railway/Fly)
TRUST_PROXY=false
# Адрес фронта — для ссылок в письмах (сброс пароля). В проде — адрес сайта.
APP_URL=http://localhost:5173/run-vision/
# Почта: smtps://логин:пароль@smtp.хост:465. Пусто — письма не отправляются, а печатаются
# в консоли сервера блоком «ПИСЬМО (SMTP не настроен…)» — ссылку сброса берите оттуда.
# Для проверки на себе — своя почта через «пароль приложения» (обычный пароль не подойдёт),
# «@» в логине пишется как %40, MAIL_FROM — тот же ящик:
#   Gmail:  SMTP_URL=smtps://you%40gmail.com:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.gmail.com:465
#   Яндекс: SMTP_URL=smtps://you%40yandex.ru:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.ru:465
#           MAIL_FROM=RunVision <you@yandex.ru>
SMTP_URL=
MAIL_FROM=RunVision <no-reply@localhost>
# Сколько минут живёт ссылка сброса пароля
PASSWORD_RESET_TTL_MINUTES=60
# Только для тестов: отдельная база, её таблицы очищаются
TEST_DATABASE_URL=postgres://runvision:runvision@localhost:5432/runvision_test

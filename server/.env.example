# Порт HTTP-сервера
PORT=3000
# Строка подключения к PostgreSQL (обязательно)
DATABASE_URL=postgres://runvision:runvision@localhost:5432/runvision
# Разрешённые источники фронта (через запятую)
CORS_ORIGINS=http://localhost:5173,https://maxrusmos.github.io
# Сколько дней живёт сессия
SESSION_TTL_DAYS=30
# Доверять заголовку X-Forwarded-For (true за прокси хостинга: Render/Railway/Fly)
TRUST_PROXY=false
# Только для тестов: отдельная база, её таблицы очищаются
TEST_DATABASE_URL=postgres://runvision:runvision@localhost:5432/runvision_test
